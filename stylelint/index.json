{
  "$schema": "https://json.schemastore.org/stylelintrc",
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/*.min.css"
  ],
  "rules": {
    "color-no-invalid-hex": true,
    "color-named": "never",
    "color-no-hex": [true, {
      "severity": "warning",
      "message": "Fatax: prefira var(--brand-*), var(--text-*), var(--surface-*). Hex literal só em codegen (dist/tokens.css). Se o token novo é legítimo, adicione ao DESIGN.md primeiro."
    }],

    "declaration-property-value-disallowed-list": {
      "/^color$|^background-color$|^border-color$|^fill$|^stroke$/": [
        "/^#000$|^#000000$/i",
        "/^black$/i",
        "/^#888$|^#888888$/i",
        "/^#777$|^#777777$/i",
        "/^#666$|^#666666$/i",
        "/^#555$|^#555555$/i",
        "/^#444$|^#444444$/i",
        "/^#333$|^#333333$/i",
        "/^#222$|^#222222$/i",
        "/^#111$|^#111111$/i",
        "/^#999$|^#999999$/i",
        "/^#aaa$|^#aaaaaa$/i",
        "/^#ccc$|^#cccccc$/i",
        "/^#ddd$|^#dddddd$/i",
        "/^#eee$|^#eeeeee$/i",
        "/^gray$|^grey$/i"
      ],
      "font-family": [
        "/Roboto/i",
        "/Helvetica/i",
        "/Arial/i",
        "/Verdana/i",
        "/Tahoma/i",
        "/Georgia/i",
        "/Times/i",
        "/Playfair/i",
        "/Open Sans/i",
        "/Lato/i",
        "/Nunito/i",
        "/Poppins/i",
        "/Montserrat/i"
      ],
      "/^background$|^background-image$/": [
        "/linear-gradient.*FF4800/i",
        "/linear-gradient.*brand-orange/i",
        "/radial-gradient.*FF4800/i"
      ],
      "box-shadow": [
        "/^[1-9]/",
        "/^0 [1-9]/"
      ]
    },

    "declaration-property-value-allowed-list": {
      "font-family": [
        "/var\\(--font-(sans|display|serif|mono)\\)/",
        "inherit",
        "initial",
        "system-ui",
        "monospace",
        "sans-serif",
        "ui-monospace",
        "/Syne|Inter|JetBrains Mono/"
      ],
      "transition-duration": [
        "/var\\(--dur-/",
        "0",
        "0s",
        "0ms"
      ],
      "transition-timing-function": [
        "/var\\(--ease-/",
        "linear",
        "step-end",
        "step-start"
      ],
      "animation-duration": [
        "/var\\(--dur-/",
        "0",
        "0s",
        "0ms"
      ],
      "animation-timing-function": [
        "/var\\(--ease-/",
        "linear"
      ]
    },

    "unit-disallowed-list": [
      ["pt", "vmin", "vmax"],
      { "message": "Fatax: use px/rem/em/% — pt é print-only, vmin/vmax fragmentam fluxo." }
    ],

    "at-rule-disallowed-list": ["debug"],
    "selector-max-id": [0, { "message": "Fatax: use class selectors. IDs quebram reusabilidade." }],
    "selector-no-qualifying-type": [true, { "ignore": ["attribute"] }],
    "no-descending-specificity": null,
    "declaration-block-no-redundant-longhand-properties": true,
    "declaration-empty-line-before": null,
    "comment-empty-line-before": null,
    "no-duplicate-selectors": true,
    "shorthand-property-no-redundant-values": true,

    "alpha-value-notation": null,
    "color-function-notation": null,
    "hue-degree-notation": null,
    "media-feature-range-notation": null,
    "selector-class-pattern": null,
    "value-keyword-case": null,
    "custom-property-pattern": ["^[a-z][a-z0-9-]*$", {
      "message": "Fatax: custom properties em kebab-case (--brand-orange, --s-md)."
    }]
  },

  "overrides": [
    {
      "files": ["**/dist/tokens.css", "**/brandbook/shared/style.css"],
      "rules": {
        "color-no-hex": null,
        "declaration-property-value-disallowed-list": {
          "font-family": [
            "/Roboto/i", "/Helvetica/i", "/Arial/i", "/Verdana/i",
            "/Tahoma/i", "/Georgia/i", "/Playfair/i", "/Open Sans/i",
            "/Lato/i", "/Nunito/i", "/Poppins/i", "/Montserrat/i"
          ]
        }
      }
    }
  ]
}
